# 这个文件是模板：所有项默认注释掉，按需打开。
# 它不在 Git 里（真正的 .env / .env.local 已被忽略），部署时生成。

# ─────────────────────────────────────────────
# 身份验证与启动（只在安装 / 重置引导里设置）
# ─────────────────────────────────────────────

# MongoDB 连接串。任何 MongoDB 都行：Atlas、自建、Railway、容器里的都行。
# MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/inslog?retryWrites=true&w=majority"

# 库名。留空则用连接串路径里的名字，再没有就用 inslog。
# 同一个集群里跑多个站点（比如博客 + 文档站）时用不同的库名区分；
# 填一个还不存在的库名，安装向导会自动把它建出来。
# MONGODB_DB_NAME="inslog"

# 会话签名密钥，同时也是加密 TOTP secret 的密钥：openssl rand -base64 32
# 注意：换掉它会让已绑定的验证器失效（secret 解不开），需要重新扫码绑定
# AUTH_SECRET="replace-with-a-long-random-secret"

# 紧急入口密钥：两把钥匙（Passkey / 验证器）都丢了时用它进门
# 用法：/login?recovery=1 里粘贴这个值
# RECOVERY_TOKEN="$(openssl rand -base64 32)"

# Passkey 依赖项：必须和正式域名完全一致，否则已绑定的 Passkey 会失效
# 本地开发不填也能用（自动按 localhost 推断）
# RP_ID="inslog.example.com"
# ORIGIN="https://inslog.example.com"

# 站点地址，用于 canonical / 分享图 / RSS
# NEXT_PUBLIC_SITE_URL="https://inslog.example.com"

# ─────────────────────────────────────────────
# 图片存储（存数据库，部署后在设置页里改）
# ─────────────────────────────────────────────
# 选一个：vercel-blob / s3 / local

# vercel-blob：Vercel → Storage → Blob 创建 store 时勾选
# "Add a read-write token env var to this connection"，或本地 vercel env pull 拉取
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# s3：任何 S3 兼容服务（R2 / MinIO / AWS S3 / OSS…）
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="inslog"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_PUBLIC_URL="https://cdn.example.com"

# local：写服务器磁盘（目录相对项目根目录）
# LOCAL_UPLOAD_DIR="uploads"

# ─────────────────────────────────────────────
# 发信（存数据库，部署后在设置页里改）
# ─────────────────────────────────────────────
# 选一个：resend / smtp

# resend：域名要先在 Resend 验证过（加 SPF/DKIM 记录）
# RESEND_API_KEY="re_..."
# RESEND_FROM="inslog <no-reply@your-domain>"

# smtp：QQ / Gmail / 阿里云邮件推送 / 自建 Postfix 都行
# SMTP_HOST="smtp.qq.com"
# SMTP_PORT="465"
# SMTP_USER="you@example.com"
# SMTP_PASSWORD="授权码，不是登录密码"
# SMTP_FROM="inslog <no-reply@your-domain>"
# SMTP_SECURE="1"
