# MongoDB Atlas 连接串（本地开发用；部署时改在 Vercel 环境变量）
# MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/inslug?retryWrites=true&w=majority"

# 会话签名密钥，同时也是加密 TOTP secret 的密钥：openssl rand -base64 32
# 注意：换掉它会让已绑定的验证器失效（secret 解不开），需要重新扫码绑定
# AUTH_SECRET="replace-with-a-long-random-secret"

# 紧急入口密钥：两把钥匙（Passkey / 验证器）都丢了时用它进门
# 用法：/login?recovery=1 里粘贴这个值。平时不要设，或者设了也当它不存在
# 进来之后立刻重新绑定验证器，然后把这个变量删掉
# RECOVERY_TOKEN="$(openssl rand -base64 32)"

# Passkey 依赖项：部署时必须和正式域名完全一致，否则已绑定的 Passkey 会失效
# 本地开发不填也能用（自动按 localhost 推断）
# RP_ID="inslug.example.com"
# ORIGIN="https://inslug.example.com"

# Vercel Blob（图片上传）：在 Vercel → Storage → Blob 创建 store 时勾选
# "Add a read-write token env var to this connection"，或本地 vercel env pull 拉取
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# 发信（Resend）：用于「更换 / 解绑验证器」的邮件确认。
# 三个条件缺一不可：RESEND_API_KEY、RESEND_FROM、设置页里的通知邮箱。
# RESEND_FROM 形如 inslug <no-reply@your-domain>，域名要先在 Resend 验证过。
# RESEND_API_KEY="re_..."
# RESEND_FROM="inslug <no-reply@your-domain>"
