# MongoDB Atlas 连接串（本地开发用；部署时改在 Vercel 环境变量）
# MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/inslog?retryWrites=true&w=majority"

# 会话签名密钥，一串长随机字符：openssl rand -base64 32
# AUTH_SECRET="replace-with-a-long-random-secret"

# 后备密码的哈希：npm run hash-password -- 你的密码
# 本地开发请写进 config/auth.json（bcrypt 哈希里有 $，写在 env 里会被 dotenv 当成变量展开）
# 部署时在 Vercel 后台填这个环境变量即可
# ADMIN_PASSWORD_HASH="$2b$12$..."

# Passkey 依赖项：部署时必须和正式域名完全一致，否则已绑定的 Passkey 会失效
# 本地开发不填也能用（自动按 localhost 推断）
# RP_ID="inslog.example.com"
# ORIGIN="https://inslog.example.com"

# Vercel Blob（图片上传）：在 Vercel → Storage → Blob 创建 store 时勾选
# "Add a read-write token env var to this connection"，或本地 vercel env pull 拉取
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# 发信（Resend）：用于「修改密码」的邮件确认。
# 三个条件缺一不可：RESEND_API_KEY、RESEND_FROM、设置页里的通知邮箱。
# RESEND_FROM 形如 inslog <no-reply@your-domain>，域名要先在 Resend 验证过。
# RESEND_API_KEY="re_..."
# RESEND_FROM="inslog <no-reply@your-domain>"
